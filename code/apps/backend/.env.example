DATABASE_URL="postgresql://user:password@localhost:5432/coride?schema=public"
JWT_SECRET="your_jwt_secret_here"
PORT=5001

# Redis — Dùng cho Geospatial Index (vị trí tài xế) và caching trạng thái online
REDIS_URL="redis://localhost:6379"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Goong Maps API Keys
# Maps API Key - Dùng để hiển thị bản đồ trên frontend (NEXT_PUBLIC_GOONG_MAPS_API_KEY)
GOONG_MAPS_API_KEY=""

# REST API Key - Dùng cho các dịch vụ backend (geocoding, directions, autocomplete)
GOONG_REST_API_KEY=""

