# Docker Compose infrastructure (development defaults)
POSTGRES_USER=root
POSTGRES_PASSWORD=change_me
POSTGRES_DB=coride_db
POSTGRES_HOST_PORT=5433

RABBITMQ_USER=coride
RABBITMQ_PASSWORD=change_me

# Shared application configuration
JWT_SECRET=replace_with_a_long_random_secret
FRONTEND_URL=http://localhost:3000

# Optional Cloudinary upload configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Goong Maps
GOONG_MAPS_API_KEY=
GOONG_REST_API_KEY=
GOONG_GEOLOCATION_ENABLED=false

# Optional payment QR information
PAYMENT_BANK_ID=
PAYMENT_ACCOUNT_NO=
PAYMENT_ACCOUNT_NAME=

# Local non-Docker backend example:
# DATABASE_URL=postgresql://root:change_me@localhost:5432/coride_db?schema=public
# REDIS_URL=redis://localhost:6379
# RABBITMQ_URL=amqp://coride:change_me@localhost:5672
