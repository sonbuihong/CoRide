generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String              @id @default(uuid())
  email                String              @unique
  password             String
  firstName            String?
  lastName             String?
  phone                String?
  avatarUrl            String?
  bio                  String?
  role                 Role                @default(USER)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  driverRating         Float               @default(5)
  driverRatingCount    Int                 @default(0)
  passengerRating      Float               @default(0)
  passengerRatingCount Int                 @default(0)
  isDriverVerified     Boolean             @default(false)
  status               UserStatus          @default(ACTIVE)
  deletedAt            DateTime?
  bookings             Booking[]           @relation("PassengerBookings")
  driverVerification   DriverVerification?
  receivedMessages     Message[]           @relation("ReceivedMessages")
  sentMessages         Message[]           @relation("SentMessages")
  notifications        Notification[]
  refreshTokens        RefreshToken[]
  reportsReceived      Report[]            @relation("ReportsReceived")
  reportsSent          Report[]            @relation("ReportsSent")
  reviewsReceived      Review[]            @relation("ReviewsReceived")
  reviewsSent          Review[]            @relation("ReviewsSent")
  ridesAsDriver        Ride[]              @relation("DriverRides")
  rideSchedules        RideSchedule[]
  tripsAsDriver        TripRequest[]       @relation("DriverTrips")
  tripsAsPassenger     TripRequest[]       @relation("PassengerTrips")
  vehicles             Vehicle[]
  wallet               Wallet?

  @@index([status, deletedAt])
}

model Wallet {
  id             String        @id @default(uuid())
  userId         String        @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  rideBalance    Float         @default(0)
  driverEarnings Float         @default(0)
  transactions   Transaction[]
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transaction {
  id            String            @id @default(uuid())
  walletId      String
  amount        Float
  type          TransactionType
  status        TransactionStatus @default(PENDING)
  description   String?
  externalId    String?           @unique
  bookingId     String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  tripRequestId String?
  booking       Booking?          @relation(fields: [bookingId], references: [id])
  tripRequest   TripRequest?      @relation(fields: [tripRequestId], references: [id])
  wallet        Wallet            @relation(fields: [walletId], references: [id])
}

model Message {
  id         String   @id @default(uuid())
  rideId     String
  senderId   String
  receiverId String
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  ride       Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  title     String
  content   String
  type      String
  isRead    Boolean   @default(false)
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  targetType String?
  targetId   String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deletedAt, createdAt])
  @@index([targetType, targetId])
}

model Ride {
  id                 String        @id @default(uuid())
  driverId           String
  origin             String
  destination        String
  departureTime      DateTime
  availableSeats     Int
  pricePerSeat       Float
  status             RideStatus    @default(SCHEDULED)
  description        String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  destinationLat     Float?
  destinationLng     Float?
  originLat          Float?
  originLng          Float?
  distance           Float?
  duration           Float?
  addressDetailLevel String?
  destAddressType    String?
  destDistrict       String?
  destHouseNumber    String?
  destProvince       String?
  destStreet         String?
  destWard           String?
  originAddressType  String?
  originDistrict     String?
  originHouseNumber  String?
  originProvince     String?
  originStreet       String?
  originWard         String?
  routePolyline      String?
  offeredSeats       Int           @default(1)
  tollCost           Float         @default(0)
  allowRoutePickup   Boolean       @default(true)
  routePickupSharingEnabled Boolean @default(false)
  bookingPolicy      BookingPolicy @default(DRIVER_APPROVAL)
  scheduleId         String?
  allowLuggage       Boolean       @default(true)
  allowPets          Boolean       @default(false)
  allowSmoking       Boolean       @default(false)
  cancelReason       String?
  vehicleId          String?
  bookings           Booking[]
  messages           Message[]
  reports            Report[]
  reviews            Review[]
  driver             User          @relation("DriverRides", fields: [driverId], references: [id])
  schedule           RideSchedule? @relation(fields: [scheduleId], references: [id])
  vehicle            Vehicle?      @relation(fields: [vehicleId], references: [id])
  stops              RideStop[]

  @@unique([driverId, departureTime])
  @@index([origin, destination, departureTime])
  @@index([originProvince, destProvince])
  @@index([scheduleId, departureTime])
}

model RideSchedule {
  id        String   @id @default(uuid())
  driverId  String
  timezone  String   @default("Asia/Ho_Chi_Minh")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rides     Ride[]
  driver    User     @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, createdAt])
}

model RideStop {
  id                 String    @id @default(uuid())
  rideId             String
  address            String
  name               String?
  latitude           Float
  longitude          Float
  order              Int
  waitTimeMinutes    Int       @default(5)
  createdAt          DateTime  @default(now())
  selectedByBookings Booking[] @relation("BookingPickupStop")
  ride               Ride      @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@unique([rideId, order])
  @@index([rideId])
}

model Booking {
  id               String        @id @default(uuid())
  rideId           String
  passengerId      String
  seats            Int
  totalPrice       Float
  status           BookingStatus @default(PENDING)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  paymentStatus    PaymentStatus @default(UNPAID)
  paymentMethod    PaymentMethod?
  sharedDistanceKm Float?
  detourKm         Float?
  priceBreakdown   Json?
  driverArrivedAt  DateTime?
  pickedUpAt       DateTime?
  droppedOffAt     DateTime?
  expiresAt        DateTime?
  seatHeld         Boolean       @default(false)
  pickupStopId     String?
  cancelReason     String?
  dropoffAddress   String?
  dropoffLat       Float?
  dropoffLng       Float?
  isDroppedOff     Boolean       @default(false)
  isPickedUp       Boolean       @default(false)
  passengerLat     Float?
  passengerLng     Float?
  pickupAddress    String?
  passenger        User          @relation("PassengerBookings", fields: [passengerId], references: [id])
  pickupStop       RideStop?     @relation("BookingPickupStop", fields: [pickupStopId], references: [id])
  ride             Ride          @relation(fields: [rideId], references: [id])
  transactions     Transaction[]

  @@index([status, expiresAt])
  @@index([pickupStopId])
}

model Review {
  id            String       @id @default(uuid())
  rideId        String?
  tripRequestId String?
  reviewerId    String
  revieweeId    String
  rating        Int
  comment       String?
  createdAt     DateTime     @default(now())
  type          ReviewType
  reviewee      User         @relation("ReviewsReceived", fields: [revieweeId], references: [id])
  reviewer      User         @relation("ReviewsSent", fields: [reviewerId], references: [id])
  ride          Ride?        @relation(fields: [rideId], references: [id])
  tripRequest   TripRequest? @relation(fields: [tripRequestId], references: [id])

  @@unique([rideId, reviewerId, revieweeId])
  @@unique([tripRequestId, reviewerId, revieweeId])
}

model DriverVerification {
  id                        String             @id @default(uuid())
  userId                    String             @unique
  licenseImageUrl           String
  vehicleImageUrl           String
  vehiclePlate              String
  vehicleModel              String?
  status                    VerificationStatus @default(PENDING)
  rejectionReason           String?
  reviewedAt                DateTime?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  licenseBackImageUrl       String
  licenseFrontImageUrl      String
  registrationBackImageUrl  String
  registrationFrontImageUrl String
  vehicleType               String             @default("BIKE")
  user                      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProvinceMapping {
  id            String   @id @default(uuid())
  oldProvince   String
  newProvince   String
  effectiveDate DateTime
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([oldProvince, effectiveDate])
  @@index([isActive])
}

model Location {
  id        String   @id @default(cuid())
  placeId   String   @unique
  name      String
  address   String
  latitude  Float
  longitude Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TripRequest {
  id                String         @id @default(uuid())
  passengerId       String
  driverId          String?
  originAddress     String
  originLat         Float
  originLng         Float
  destAddress       String
  destLat           Float
  destLng           Float
  vehicleType       VehicleType    @default(BIKE)
  estimatedDistance Float
  estimatedDuration Float
  estimatedPrice    Float
  finalPrice        Float?
  paymentStatus     PaymentStatus  @default(UNPAID)
  paymentMethod     PaymentMethod?
  status            TripStatus     @default(PENDING)
  matchAttempts     Int            @default(0)
  maxAttempts       Int            @default(10)
  matchRadius       Float          @default(5)
  matchedAt         DateTime?
  arrivedAt         DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  cancelReason      String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  reports           Report[]
  reviews           Review[]
  transactions      Transaction[]
  driver            User?          @relation("DriverTrips", fields: [driverId], references: [id])
  passenger         User           @relation("PassengerTrips", fields: [passengerId], references: [id])

  @@index([passengerId, status])
  @@index([driverId, status])
  @@index([status, createdAt])
  @@index([originLat, originLng])
}

model PricingConfig {
  id                    String      @id @default(uuid())
  vehicleType           VehicleType @unique
  baseFare              Float
  pricePerKm            Float
  pricePerMinute        Float       @default(0)
  baseDistance          Float       @default(2)
  minFare               Float       @default(0)
  isActive              Boolean     @default(true)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  fuelPrice             Float       @default(22119)
  fuelConsumption       Float       @default(6.5)
  vehicleOverheadRatio  Float       @default(0.5)
  minimumDriverShare    Float       @default(0.2)
  driverPriceAdjustment Float       @default(0.2)
  roundingUnit          Int         @default(1000)
  maxDetourKm           Float       @default(5)
  maxDetourRatio        Float       @default(0.1)
}

model Vehicle {
  id           String        @id @default(uuid())
  userId       String
  licensePlate String        @unique
  type         VehicleType   @default(BIKE)
  color        String?
  status       VehicleStatus @default(ACTIVE)
  imageUrl     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  rides        Ride[]
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OTP {
  id        String   @id @default(uuid())
  email     String
  otp       String
  isUsed    Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model Report {
  id            String       @id @default(uuid())
  reporterId    String
  reportedId    String
  rideId        String?
  tripRequestId String?
  reason        String
  detail        String?
  status        ReportStatus @default(PENDING)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  reported      User         @relation("ReportsReceived", fields: [reportedId], references: [id])
  reporter      User         @relation("ReportsSent", fields: [reporterId], references: [id])
  ride          Ride?        @relation(fields: [rideId], references: [id])
  tripRequest   TripRequest? @relation(fields: [tripRequestId], references: [id])
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
  DELETED
}

enum RideStatus {
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
  FULL
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REJECTED
  EXPIRED
  COMPLETED
}

enum BookingPolicy {
  INSTANT
  DRIVER_APPROVAL
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  PAYMENT
  RECEIVE_PAYMENT
  REFUND
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum PaymentMethod {
  CASH
  QR
  ZALOPAY
  WALLET
}

enum ReviewType {
  DRIVER
  PASSENGER
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TripStatus {
  PENDING
  MATCHING
  ACCEPTED
  ARRIVING
  ARRIVED
  IN_PROGRESS
  WAITING_PAYMENT
  COMPLETED
  CANCELLED
  NO_DRIVER
}

enum VehicleType {
  BIKE
  CAR
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
}

enum ReportStatus {
  PENDING
  RESOLVED
  REJECTED
}
